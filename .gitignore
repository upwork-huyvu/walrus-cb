# ===== Root .gitignore (cool-bath monorepo) =====

.DS_Store
node_modules/

# ---- Secrets / SDK (TUYỆT ĐỐI KHÔNG commit) ----
# docs/sdk/**/*.zip
# docs/sdk/**/*.tar.gz
# docs/sdk/Android_SDK/
# docs/sdk/iOS_SDK/

# env (chỉ commit *.example)
**/.env
**/.env.*
!**/.env.example

# Secret project-local (chỉ commit *.example)
**/secrets.properties
**/secrets.xcconfig

# Tuya security files (binary, per-app)
**/security-algorithm*.aar
**/ios_core_sdk.tar.gz
**/ThingSmartCryption*

# build outputs
**/dist/
**/.next/
**/*.tsbuildinfo


# Google OAuth client downloads - client_secret*.json chứa secret, KHÔNG commit
**/client_secret*.json
**/GoogleService-Info.plist
# Firebase (FCM) app config - chứa định danh project, KHÔNG commit
**/google-services.json
.playwright-mcp/*
docs/pdf/
.claude


# Handover doc chứa mật khẩu/secret - KHÔNG commit
docs/handover/
